# Copy to `.env` (gitignored). Pytest và CI vẫn ép CA_AGENT_MODE=replay.
# Database/runtime thật
DATABASE_URL=postgresql+psycopg://nhipquan:change_me@localhost:5433/nhipquan
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GEMINI_LIVE_VOICE_ENABLED=true
DOMAIN=nhipquan.duckdns.org
# CORS: chỉ điền khi chạy domain thật. Để TRỐNG khi phát triển local —
# điền vào sẽ GHI ĐÈ danh sách mặc định (localhost:3000/3001) và web local
# sẽ bị chặn CORS.
NHIPQUAN_CORS_ORIGINS=https://nhipquan.duckdns.org

# Swagger/OpenAPI công khai. `1` = bật (mặc định, cần cho demo/hội đồng).
# Đặt `0` khi vận hành quán thật để tắt /docs, /redoc, /openapi.json.
NHIPQUAN_PUBLIC_API_DOCS=1

# Không tự sinh dữ liệu demo/fixture
NHIPQUAN_SEED_DEMO=false
NHIPQUAN_INBOX_SEED_FIXTURE=0
NHIPQUAN_PAGE_SEED_FIXTURE=0
NHIPQUAN_LOI_GIAI_SEED=0

# Agent và kênh thật; thiếu credential thì hệ thống fail-closed, không bịa dữ liệu
CA_AGENT_MODE=live
NHIPQUAN_PAGE_MODE=live
GEMINI_LIVE_VOICE_ENABLED=true

# Bật live để AG-RULE / AG-SOP / AG-MSG dùng LLM (cần ít nhất một key bên dưới).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# ── Sinh ảnh quảng cáo menu (AI) ──
# Cloudflare Workers AI — PROVIDER CHÍNH, làm được cả SINH MỚI lẫn SỬA ẢNH THẬT.
# Miễn phí 10.000 neurons/NGÀY (≈80–95 ảnh 1024×1024, reset 00:00 UTC), không cần
# thẻ tín dụng. Lấy key:
#   1. Tạo tài khoản tại https://dash.cloudflare.com (miễn phí)
#   2. Vào Workers AI → tab "Use REST API" → "Create a Workers AI API Token"
#   3. Copy TOKEN → CLOUDFLARE_API_TOKEN; ACCOUNT ID (hiện trong đoạn code mẫu
#      Cloudflare đưa ra) → CLOUDFLARE_ACCOUNT_ID
# Cần CẢ HAI biến; thiếu một trong hai thì hệ thống tự rơi xuống Gemini rồi
# Pollinations (chậm hơn, phụ thuộc quota/rate-limit của họ).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Model sinh/sửa ảnh. Trống = @cf/black-forest-labs/flux-2-klein-4b (rẻ, nhanh).
# Đặt @cf/black-forest-labs/flux-2-dev khi cần chất lượng cao hơn (tốn neurons hơn).
CLOUDFLARE_IMAGE_MODEL=

# Gemini image model (dự phòng; cần quota, free tier thường trả 429 limit=0).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── Sửa ẢNH THẬT (image-to-image) ──
# Chế độ "edit_photo" dùng CLOUDFLARE_ACCOUNT_ID/API_TOKEN ở trên. Không cần
# biến riêng. Nếu chưa có Cloudflare, lấy key Pollinations MIỄN PHÍ (đăng nhập
# GitHub tại https://enter.pollinations.ai/keys → tạo key sk_...) dán vào đây
# làm phương án hai; hệ thống cũng thử Gemini image cuối cùng.
POLLINATIONS_API_KEY=
# Model image-editing. Trống = black-forest-labs/flux.1-kontext-pro.
POLLINATIONS_IMAGE_MODEL=

# Pollinations: text-to-image miễn phí, không cần key (dự phòng cuối).
# GHIM model = tắt fallback sang model nhẹ hơn. Bỏ trống dòng dưới nếu ưu tiên
# TỐC ĐỘ: khi "flux" quá tải, hệ thống tự thử "turbo" (nhanh hơn ~4 lần) thay vì
# để người dùng chờ hết ngân sách thời gian.
POLLINATIONS_MODEL=flux

OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

# ── B.ai (Free models: qwen3.8-flash, mimo-v2.5, hy3) ──
BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai/v1
BAI_MODEL=qwen3.8-flash

# Optional local fallback. Leave unset to skip a hanging localhost probe.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# ── Jev (TypeSafe System One) — cảm biến xác suất (kế hoạch JEV v2) ──
# Bật Jev thật: điền JEV_API_KEY + JEV_ENABLED=true.
# Mặc định tắt (fail-closed): thiếu key → JevSensor trả ok=False, code thoái lui
# về phía con người (ADR-008). Ghim phiên bản jev-1.13.0, không dùng jev-latest.
JEV_API_KEY=
JEV_ENABLED=false
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_ENDPOINT=/v1/systemone

# ── Kênh tin (Zalo ưu tiên tại VN) ──
# AI hiểu tin thật khi CA_AGENT_MODE=live + có key LLM ở trên.
# NHIPQUAN_MSG_BACKEND=zalo
# NHIPQUAN_ZALO_ENABLED=1
# NHIPQUAN_ZALO_OA_ACCESS_TOKEN=

# ── Telegram bot live ──
# 1. Tạo bot với @BotFather → dán token vào đây.
# 2. NHIPQUAN_MSG_BACKEND=telegram để bot TRẢ LỜI + worker nhận tin (long-poll,
#    không cần public webhook — hợp với máy AWS không bị firewall chặn ngõ vào).
# 3. (Tuỳ chọn) Nếu đặt webhook qua setWebhook thì thêm secret bên dưới;
#    khi có webhook thì tắt long-poll bằng cách đổi MSG_BACKEND về zalo/console.
# NHIPQUAN_MSG_BACKEND=telegram
# NHIPQUAN_TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# NHIPQUAN_TELEGRAM_WEBHOOK_SECRET=
# NHIPQUAN_FB_PAGE_TOKEN=   # Page access token từ Graph API v26 me/accounts
# NHIPQUAN_FB_PAGE_ID=      # id Page (vd. Nhịp Quán)
# NHIPQUAN_PAGE_MODE=live
# NHIPQUAN_FB_WEBHOOK_VERIFY=change-me
# Chỉ bật khi chạy pytest kênh tin / replay:
# NHIPQUAN_ALLOW_MSG_REPLAY=1
# Chỉ CI: nhồi inbox fixture. Quán để tắt (mặc định).
# NHIPQUAN_INBOX_SEED_FIXTURE=1
# Dev/test/demo: thêm 21 NV mẫu ADR-012 vào pool xếp lịch (lịch sử công bằng).
# Quán vận hành thật để TẮT (mặc định) — lịch tuần chỉ dùng nhân viên thật.
# NHIPQUAN_LOI_GIAI_SEED=1

# ── Gửi Gmail / Email qua SMTP ──
# Bắt buộc CA_AGENT_MODE=live để gửi thật (nếu replay chỉ ghi log data/out/mail_log.jsonl).
# Cách lấy Google App Password:
# 1. Bật Xác minh 2 bước (2-Step Verification) trên Google Account.
# 2. Truy cập: https://myaccount.google.com/apppasswords
# 3. Tạo mật khẩu ứng dụng mới (16 ký tự, ví dụ: abcd efgh ijkl mnop).
# NHIPQUAN_SMTP_HOST=smtp.gmail.com
# NHIPQUAN_SMTP_PORT=587
# NHIPQUAN_SMTP_USER=ten_email_cua_ban@gmail.com
# NHIPQUAN_SMTP_PASSWORD=abcd efgh ijkl mnop
# NHIPQUAN_SMTP_FROM="Nhịp Quán <ten_email_cua_ban@gmail.com>"

# ── Camoufox — browser thật chống-detect cho AG-TREND (optional) ──
# Cài: pip install -U "camoufox[geoip]"  rồi chạy: camoufox fetch  (~300MB binary).
# Chưa cài / chưa fetch → tier Camoufox tự rớt (CamoufoxUnavailable), không crash.
# CA_CAMOUFOX_ENABLED=1
# CA_CAMOUFOX_HEADLESS=1
# CA_CAMOUFOX_TIMEOUT_S=45
# CA_CAMOUFOX_MAX_CONCURRENT=2
# Cache kết quả cào theo keyword (giây) — 0 = tắt cache.
# CA_CAMOUFOX_CACHE_TTL_S=600

# ── Threads Official API — tier 0 keyword search (graph.threads.net, miễn phí) ──
# Cách lấy token: https://developers.facebook.com → tạo app → product Threads →
# permissions threads_basic + threads_keyword_search → Graph API Explorer sinh token.
# Rate limit 2,200 queries/24h. Chưa set → tier tự skip, không đổi hành vi.
# THREADS_ACCESS_TOKEN=

# ── Trend Discovery — tự phát hiện từ khoá trending MỚI từ báo chí tổng hợp ──
# Pipeline: Google News RSS (query "meta-keyword" + tháng) → bóc candidate →
# chấm điểm → xếp hạng. Miễn phí, không quota, không cần API key.
# Mọi ngưỡng dưới đây có thể bỏ trống (dùng default trong code).
# Số query tối đa mỗi lần quét (nhiều query = bắt rộng hơn nhưng chậm hơn).
# TREND_DISCOVERY_MAX_QUERIES=14
# Candidate phải xuất hiện ≥ N lần mới nhận (2 = cân bằng; 3 = siết chặt).
# TREND_DISCOVERY_MIN_MENTIONS=2
# Số NGUỒN báo tối thiểu (1 = nhiều bài cùng 1 báo vẫn tính).
# TREND_DISCOVERY_MIN_SOURCES=1
# Độ tin cậy tối thiểu (0.0–1.0). Nâng lên để chỉ giữ tín hiệu mạnh.
# TREND_DISCOVERY_MIN_CONFIDENCE=0.0
# Bài cũ hơn N ngày bị loại (45 = chỉ lấy trend trong ~1.5 tháng).
# TREND_DISCOVERY_MAX_FRESHNESS_DAYS=45
# Số candidate trả về tối đa.
# TREND_DISCOVERY_MAX_CANDIDATES=20
# Nghỉ giữa 2 request RSS (giây) — lịch sự với nguồn miễn phí.
# TREND_DISCOVERY_QUERY_DELAY_S=0.4

# ── Quản lý Gmail (OAuth 2.0) ──
# Docker compose (infra/docker/compose.yml) nạp env từ file .env Ở ROOT này,
# nên biến Gmail phải có ở đây — không chỉ trong apps/api/.env.example.
# Tạo OAuth client: Google Cloud Console → Google Auth Platform → Clients
# → Create Client → Web application.
# Redirect URI phải khớp TUYỆT ĐỐI (kể cả dấu /):
#   http://localhost:8000/api/v1/gmail/oauth/callback
# Chi tiết: docs/runbooks/gmail-oauth-connect.md
# Thiếu 2 biến đầu ⇒ GET /api/v1/gmail/oauth/authorize trả 503 (fail-closed).
NHIPQUAN_GMAIL_CLIENT_ID=
NHIPQUAN_GMAIL_CLIENT_SECRET=
NHIPQUAN_GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback

# ── Mã hoá token Gmail (Fernet, BẮT BUỘC ở production) ──
# Sinh key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Thiếu key ⇒ key tạm sinh mỗi lần khởi động, token cũ KHÔNG đọc lại được sau restart.
# Đổi key sau khi đã kết nối ⇒ mọi token cũ hỏng, phải Thu hồi rồi kết nối lại.
NHIPQUAN_ENCRYPTION_KEY=

# ── SerpApi — Google Maps, Google Trends, Reviews cho F&B (Free tier: 250 req/tháng) ──
# Cách lấy token: Đăng ký tại https://serpapi.com → Dashboard → copy API Key.
# SERPAPI_API_KEY=
# SERPAPI_ENABLED=true
# SERPAPI_MONTHLY_LIMIT=250
# SERPAPI_SAFETY_MARGIN=10
# SERPAPI_WARN_THRESHOLD=200
# SERPAPI_INFO_THRESHOLD=150
# SERPAPI_CACHE_TTL_MAPS_HOURS=24
# SERPAPI_CACHE_TTL_PHOTOS_DAYS=7
# SERPAPI_CACHE_TTL_TRENDS_HOURS=12
# TTL riêng cho bảng 'Trending Now' cấp quốc gia (dữ liệu thời gian thực, đổi vài chục phút/lần)
# SERPAPI_CACHE_TTL_TRENDING_NOW_HOURS=1
# SERPAPI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# SERPAPI_CIRCUIT_BREAKER_OPEN_SECONDS=300
# SERPAPI_ONDEMAND_RATE_LIMIT_PER_MIN=3

