/check_jobs.py

# data/out/ = output tooling (do_metrics, contrast, screenshot audit, mail log…)
# Mỗi script tự ghi ra khi chạy — KHÔNG track kết quả شم沉着 cũ. Giữ .gitkeep.
data/out/*
!data/out/.gitkeep
# Nén tay output cũ — artifact local, không commit (data/out/* chỉ khớp thư mục).
data/out.rar
data/out.zip
data/out.7z

