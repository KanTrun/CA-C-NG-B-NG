# Caddy reverse-proxy — tự xin + gia hạn Let's Encrypt certificate.
# {$DOMAIN} đọc từ biến môi trường container (đặt trong .env trên VM).

{$DOMAIN} {
	encode gzip

	# ── Header bảo mật tầng TLS (QA 2026-09-30 N1) ──────────────────────────
	# HSTS chỉ có ý nghĩa khi browser đi qua HTTPS công khai, nên đặt ở Caddy
	# (nơi giữ chứng chỉ) thay vì ở Next/API nội bộ (http://web:3000,
	# http://api:8000). Các header còn lại (nosniff/DENY/CSP/…) do từng tầng tự
	# đặt vì CSP của API (`default-src 'none'`) khác CSP của web HTML — đặt một
	# CSP chung ở đây sẽ ghi đè và phá một trong hai. Không thêm `header` cho
	# CSP/X-Frame ở đây để tránh ghi đè upstream.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# ── WebSocket (phải khai TRƯỚC các handle khác) ────────────────────────
	# Hệ thống có 3 WebSocket:
	#   /ws/chat              — chat nội bộ (lib/realtime.ts)
	#   /api/v1/copilot/voice — Copilot Voice (Gemini Live)
	#   /api/v1/meeting/stream— AG-MEETING streaming
	# Caddy tự nâng cấp giao thức (Connection: Upgrade) khi client yêu cầu, NHƯNG
	# cần `handle` riêng để không bị các matcher khác chặn. QA 2026-09-26 phát
	# hiện /ws/chat trả 502 khi chỉ khai mỗi path này mà thiếu flush_interval.
	handle /ws/chat* {
		reverse_proxy api:8000 {
			# Tắt buffering để frame realtime đi ngay, không bị gộp.
			flush_interval -1
		}
	}
	handle /api/v1/copilot/voice {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle /api/v1/meeting/stream {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# API — tách path /api/* và /docs, /health, /openapi.json
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle /docs* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}

	# Web Next.js — mọi path mặc định
	handle {
		reverse_proxy web:3000
	}
}

# Port 80 chỉ phục vụ ACME challenge + redirect sang HTTPS (Caddy tự làm).
