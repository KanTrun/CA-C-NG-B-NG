# =================================================================
# Crew-Operations env template — COPY sang .env rồi điền giá trị thật
# KHÔNG commit file .env (đã có trong .gitignore)
# =================================================================

# ─── Agent mode ───
CA_AGENT_MODE=live
GEMINI_LIVE_VOICE_ENABLED=true

# ─── LLM providers ───
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# ─── Facebook Page ───
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here
FACEBOOK_PAGE_ID=me
FACEBOOK_PAGE_NAME=Nhịp Quán
NHIPQUAN_FB_PAGE_TOKEN=your_page_access_token_here
NHIPQUAN_FB_PAGE_ID=me
NHIPQUAN_PAGE_MODE=live
NHIPQUAN_FB_WEBHOOK_VERIFY=change-me
# BẮT BUỘC để webhook thật nhận sự kiện từ Meta:
# Meta App Dashboard → App Settings → Basic → App Secret (xem docs/runbooks/fb-chatbot-moderation.md)
# Nếu rỗng/thiếu: mọi POST webhook từ Meta sẽ bị 403 (fail-closed).
NHIPQUAN_FB_APP_SECRET=your_app_secret_here

# ─── TikTok scraping (TikWM primary + Apify backup) ───
# Đăng ký tại https://console.apify.com/ — gói Free có hạn mức tháng;
# số thật hiển thị ở /page-quan hoặc GET /api/v1/trends/apify-usage
# Settings → Integrations → Token → Create new
APIFY_TOKEN=your_apify_token_here
APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
TIKTOK_APIFY_TIMEOUT_S=90

# ─── Quản lý Gmail (OAuth 2.0) ───
# Tạo OAuth client tại https://console.cloud.google.com/apis/credentials
# Bật Gmail API, thêm redirect URI: http://localhost:8000/api/v1/gmail/oauth/callback
# Thiếu 2 biến đầu ⇒ endpoint /api/v1/gmail/oauth/authorize trả 503 (fail-closed).
NHIPQUAN_GMAIL_CLIENT_ID=your_google_oauth_client_id_here
NHIPQUAN_GMAIL_CLIENT_SECRET=your_google_oauth_client_secret_here
NHIPQUAN_GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback

# ─── Mã hoá token nhạy cảm (Fernet) ───
# BẮT BUỘC ở production: token Gmail được mã hoá trước khi ghi DB.
# Sinh key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Thiếu key ⇒ key tạm sinh mỗi lần khởi động, token cũ KHÔNG đọc lại được sau restart.
NHIPQUAN_ENCRYPTION_KEY=your_fernet_key_here